# Redis Configuration (if using RedisAdapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600

# PostgreSQL Configuration (if using PostgreSQLAdapter)
DATABASE_URL=postgresql://user:password@localhost/memory_db

# Elasticsearch Configuration (if using ElasticsearchMemory)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Memory Configuration
MAX_BUFFER_TOKENS=4096
MAX_WINDOW_TOKENS=8192
SUMMARIZATION_TRIGGER_RATIO=0.8
